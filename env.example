# Flare Node Configuration
# Copy this file to .env and customize for your setup

# === REQUIRED SETTINGS ===
# Network: flare, coston, costwo, songbird
NETWORK=flare

# Node version (check https://hub.docker.com/r/flarefoundation/go-flare/tags)
NODE_TAG=go-flare:v1.11.0

# Database directory path (must be absolute path)
DB_DIR=/mnt/disks/db

# === OPTIONAL SETTINGS ===
# HTTP host for API access (default: 0.0.0.0 for all interfaces)
HTTP_HOST=0.0.0.0

# Node type: observer or validator
NODE_TYPE=observer

# Extra arguments to pass to the node (space-separated)
# Examples: --http-allowed-hosts="*" --index-enabled=1
# NOTE: Validators must specify: --staking-tls-cert-file=/app/staking/staker.crt --staking-tls-key-file=/app/staking/staker.key --staking-signer-key-file=/app/staking/signer.key
EXTRA_ARGUMENTS=--http-allowed-hosts="*"

# === AUTO-CONFIGURED (DO NOT MODIFY - SKIP TO BOOTSTRAP_ENDPOINT) ===
# Bootstrap endpoint - automatically set based on NETWORK
BOOTSTRAP_ENDPOINT_FLARE=https://flare-bootstrap.flare.network/ext/info
BOOTSTRAP_ENDPOINT_COSTON=https://coston-bootstrap.flare.network/ext/info
BOOTSTRAP_ENDPOINT_COSTWO=https://coston2-bootstrap.flare.network/ext/info
BOOTSTRAP_ENDPOINT_SONGBIRD=https://songbird-bootstrap.flare.network/ext/info

# Change this based on the network you are running (based on ENV variabeles below or specify a custom one)
BOOTSTRAP_ENDPOINT=${BOOTSTRAP_ENDPOINT_FLARE}