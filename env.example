# Flare Node Configuration
# Copy this file to .env and customize for your setup

# === REQUIRED SETTINGS ===
# Network: flare, coston, costwo, songbird
NETWORK=flare

# Node image tag. go-flare:latest on Docker Hub was last pushed on 2024-12-02
# and does not include Helicon. Set the version you want at install time:
#   ./setup.sh --tag go-flare:v1.15.1
NODE_TAG=go-flare:latest

# Database directory path (must be absolute path)
DB_DIR=/mnt/disks/db

# === OPTIONAL SETTINGS ===
# In-container RPC bind. Leave this at 0.0.0.0 so Docker can reach the process.
# To keep RPC off the public interface, set HTTP_PUBLISH_HOST=127.0.0.1 instead.
HTTP_HOST=0.0.0.0

# Host address that publishes the RPC port (9650).
# When this is unset, Compose uses HTTP_HOST, which keeps existing installs unchanged.
HTTP_PUBLISH_HOST=0.0.0.0

# Host address that publishes the staking port (9651).
# Validators need peers to reach this. When unset, Compose uses HTTP_HOST.
STAKING_PUBLISH_HOST=0.0.0.0

# Hostnames allowed to call the RPC. The image passes this as --http-allowed-hosts.
HTTP_ALLOWED_HOSTS=*

# Node type: observer or validator
NODE_TYPE=observer

# Extra arguments to pass to the node (space-separated).
# setup.sh adds the staking file flags for a validator. Do not put --http-allowed-hosts here.
EXTRA_ARGUMENTS=

# Optional bootstrap override. Leave this unset to use the image default (Coston2).
# The node does not choose a bootstrap URL from NETWORK.
# Examples:
# BOOTSTRAP_ENDPOINT=https://flare-bootstrap.flare.network/ext/info
# BOOTSTRAP_ENDPOINT=https://coston-bootstrap.flare.network/ext/info
# BOOTSTRAP_ENDPOINT=https://coston2-bootstrap.flare.network/ext/info
# BOOTSTRAP_ENDPOINT=https://songbird-bootstrap.flare.network/ext/info